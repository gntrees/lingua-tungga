package strings {
  test "split and join round trip" {
    expect.eq("a,b,c".split(","), ["a", "b", "c"])
    expect.eq("a,b,c".split(",").join("-"), "a-b-c")
  }

  test "replace and slice" {
    expect.eq("a-b".replace("-", "+"), "a+b")
    expect.eq("héllo".slice(1, 3), "él")
  }

  test "predicates" {
    expect.true("hello".contains("ell"))
    expect.true("hello".starts_with("he"))
    expect.false("hello".ends_with("lo!"))
  }

  test "case and trim" {
    expect.eq("  Hi  ".trim().lower(), "hi")
    expect.eq("abc".upper(), "ABC")
  }

  test "chars are code points" {
    expect.eq("ab".chars(), ["a", "b"])
    expect.eq("👍".chars().len(), 1)
  }

  test "trim_indent removes common indent" {
    expect.eq(
      `
  a
  b
`.trim_indent(),
      "a\nb",
    )
  }

  test "parse helpers" {
    expect.eq(" 42 ".parse_int(), Some(42))
    expect.eq("nope".parse_int(), None)
    expect.eq("1.5".parse_float(), Some(1.5))
  }
}
