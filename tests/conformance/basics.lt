package basics {
  export fn max_int() -> Int {
    9223372036854775807
  }

  export fn min_int() -> Int {
    -9223372036854775807 - 1
  }

  test "int wraps at i64" {
    expect.eq(max_int() + 1, min_int())
  }

  test "division truncates toward zero" {
    expect.eq(-7 / 2, -3)
    expect.eq(-7 % 2, -1)
    expect.eq(7 / 2, 3)
  }

  test "floats follow ieee" {
    expect.true(1.0 / 0.0 > 0.0)
    expect.false(0.0 / 0.0 == 0.0 / 0.0)
  }

  test "strings count code points" {
    expect.eq("héllo".len(), 5)
    expect.eq("👍".len(), 1)
    expect.eq("héllo".slice(1, 3), "él")
  }

  test "template uses display" {
    expect.eq(`a${1 + 1}b`, "a2b")
  }

  test "equality is structural" {
    expect.eq(max_int(), 9223372036854775807)
    expect.not_equal(1, 2)
  }
}
