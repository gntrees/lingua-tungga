// Regression: shapes that broke the Python/Go emitters on a real port.
// - two `match` arms binding the same name
// - `let` inside sibling `match` arms
// - `if` expression producing `Str`
// - functions named after Python builtins (`int`, `str`) and after the runtime
// alias (`lt`)
// - a `match` binding that is never used (Go rejects unused locals)
package emitter_edges {
  export enum Shape {
    Circle(Int)
    Square(Int)
    Named(Str, Int)
  }

  export fn area(shape: Shape) -> Int {
    match shape {
      Shape.Circle(r) => r * r * 3
      Shape.Square(side) => side * side
      Shape.Named(label, size) => size
    }
  }

  export fn describe(shape: Shape) -> Str {
    match shape {
      Shape.Circle(r) => {
        let text = if r > 10 {
          "big"
        } else {
          "small"
        }
        `circle ${text}`
      }
      Shape.Square(side) => {
        let text = if side > 10 {
          "big"
        } else {
          "small"
        }
        `square ${text}`
      }
      Shape.Named(label, _) => label
    }
  }

  export fn int() -> Int {
    1
  }

  export fn str() -> Str {
    "s"
  }

  export fn lt() -> Bool {
    true
  }

  fn unused_binding(shape: Shape) -> Str {
    match shape {
      Shape.Circle(_) => "circle"
      Shape.Named(label, _) => label
    }
  }

  test "same binding names" {
    expect.eq(area(Shape.Circle(2)), 12)
    expect.eq(area(Shape.Square(3)), 9)
    expect.eq(describe(Shape.Circle(2)), "circle small")
    expect.eq(describe(Shape.Square(20)), "square big")
  }

  test "builtin named functions" {
    expect.eq(int(), 1)
    expect.eq(str(), "s")
    expect.true(lt())
  }

  test "unused match binding" {
    expect.eq(unused_binding(Shape.Circle(1)), "circle")
  }
}
