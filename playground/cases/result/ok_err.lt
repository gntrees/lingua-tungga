package ok_err {
  export fn divide(a: Int, b: Int) -> Result<Int, Str> {
    if b == 0 {
      Err("division by zero")
    } else {
      Ok(a / b)
    }
  }

  test "ok" {
    expect.eq(divide(8, 2), Ok(4))
  }

  test "err" {
    expect.eq(divide(1, 0), Err("division by zero"))
  }

  test "predicates" {
    expect.true(divide(8, 2).is_ok())
    expect.true(divide(1, 0).is_err())
  }
}
