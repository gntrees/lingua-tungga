package ordering {
  export struct Point {
    x: Int
    y: Int
  }

  export enum Grade {
    Low
    Mid
    High
  }

  test "structs sort by field order" {
    let a = Point(x: 2, y: 0)
    let b = Point(x: 10, y: 0)
    expect.eq([b, a].sort(), [a, b])
    expect.eq([Point(x: 1, y: 2), Point(x: 1, y: 1)].sort(), [Point(x: 1, y: 1), Point(x: 1, y: 2)])
  }

  test "enums sort by declaration order" {
    expect.eq([Grade.High, Grade.Low, Grade.Mid].sort(), [Grade.Low, Grade.Mid, Grade.High])
  }

  test "map keys follow ord" {
    let empty: Map<Point, Str> = map.empty()
    let filled = empty.insert(Point(x: 10, y: 0), "ten").insert(Point(x: 2, y: 0), "two")
    expect.eq(filled.keys(), [Point(x: 2, y: 0), Point(x: 10, y: 0)])
  }
}
