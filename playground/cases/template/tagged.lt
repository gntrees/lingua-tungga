package tagged {
  export enum SqlArg {
    I(Int)
    S(Str)
  }

  export struct Query {
    text: Str
  }

  export fn compose(parts: List<Str>, values: List<SqlArg>) -> Query {
    let rendered = values.map(
      fn(value) => (match value {
        SqlArg.I(n) => `i${n}`
        SqlArg.S(s) => `s${s}`
      }),
    )
    Query(text: `${parts.join("|")}::${rendered.join("|")}`)
  }

  test "splits parts and typed values" {
    let id = 7
    let query = compose`id = ${SqlArg.I(id)} and name = ${SqlArg.S("bo")}`
    expect.eq(query.text, "id = | and name = |::i7|sbo")
  }
}
