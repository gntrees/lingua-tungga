pub class Label {
  value: Str
  children: List<Str>
}

pub class View {
  pub fn label(prefix: Str, text: Str) -> Label {
    <Label value="prefix">
      {prefix}
    </Label>
  }

  pub fn plain() -> Label {
    <Label value="plain"></Label>
  }
}

test class JsxTest {
  test fn expression_child() {
    let node = View.label("hi", "ignored")
    Expect.equal(node.value, "prefix")
    Expect.equal(node.children, ["hi"])
  }

  test fn empty_children() {
    Expect.equal(View.plain().children.len(), 0)
  }
}
