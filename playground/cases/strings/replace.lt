package replace {
  export fn dash_to_plus(text: Str) -> Str {
    text.replace("-", "+")
  }

  export fn middle(text: Str) -> Str {
    text.slice(1, 3)
  }

  test "replaces all" {
    expect.eq(dash_to_plus("a-b-c"), "a+b+c")
  }

  test "slices code points" {
    expect.eq(middle("héllo"), "él")
    expect.eq("👍ab".slice(0, 1), "👍")
  }
}
