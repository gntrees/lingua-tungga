(* =====================================================================
   Lingua Tungga — Grammar v2.0 (draft, branch `explore/package-struct`)
   Cakupan: v2 — `class` dihapus, diganti `package` + `struct` + fungsi
   ber-receiver. Lihat docs/v2-decisions.md untuk alasan tiap keputusan.
   Notasi: EBNF, `,` = urutan, `[ ]` = opsional, `{ }` = nol atau lebih,
           `|` = alternatif.
   ===================================================================== *)

(* ---------- Program ---------- *)

Program        = { Import } , { PackageDecl } , EOF ;

(* Import menunjuk PACKAGE, bukan file. Path wajib; nama package dinyatakan
   eksplisit di sini dan diverifikasi ada di file target.
   Entri boleh berdiri sendiri atau dikelompokkan dalam satu blok `( ... )`,
   satu entri per baris tanpa koma. *)
Import         = "import" , ( ImportEntry | ImportGroup ) ;

ImportGroup    = "(" , { ImportEntry } , ")" ;

ImportEntry    = Identifier , [ "as" , Identifier ] ,
                 [ "{" , ImportList , "}" ] , StringLit ;

ImportList     = ImportItem , { "," , ImportItem } ;

ImportItem     = Identifier , [ "as" , Identifier ] ;

(* Wajib membungkus seluruh deklarasi. Tidak ada deklarasi telanjang di
   top-level, tidak ada nesting package. Satu file boleh berisi 1..N. *)
PackageDecl    = "package" , Identifier , "{" , { PackageItem } , "}" ;

PackageItem    = StructDecl | EnumDecl | FnDecl | Binding | TestDecl ;

(* ---------- Deklarasi ---------- *)

StructDecl     = [ "export" ] , "struct" , Identifier , [ Generics ] ,
                 "{" , { FieldDecl } , "}" ;

FieldDecl      = Identifier , ":" , Type ;

EnumDecl       = [ "export" ] , "enum" , Identifier , [ Generics ] ,
                 "{" , { Variant } , "}" ;

Variant        = Identifier , [ "(" , Type , { "," , Type } , ")" ] ;

(* Tidak ada method di dalam tipe. Fungsi ber-receiver adalah fungsi biasa
   yang parameter pertamanya bertipe struct/enum, dan wajib berada di
   package yang sama dengan tipe tersebut. *)
FnDecl         = [ "export" ] , "fn" , Identifier ,
                 "(" , [ ParamList ] , ")" , [ "->" , Type ] , Block ;

ParamList      = Param , { "," , Param } ;

Param          = Identifier , ":" , Type ;

(* Binding level-package: immutable, eager, tanpa siklus inisialisasi. *)
Binding        = [ "export" ] , "let" , Identifier , [ ":" , Type ] , "=" , Expr ;

(* Judul test adalah string literal, unik per package. *)
TestDecl       = "test" , StringLit , Block ;

(* ---------- Tipe ---------- *)

Type           = TypePath , [ Generics ] , [ "?" ] ;

(* Maksimum 3 segmen: package.Type , package.Type.Variant , package.fn.
   Batas ini ditegakkan semantik, bukan sintaks. *)
TypePath       = Identifier , { "." , Identifier } ;

Generics       = "<" , Type , { "," , Type } , ">" ;

(* ---------- Statement ---------- *)

Block          = "{" , { Stmt } , "}" ;

Stmt           = LetStmt | AssignStmt | ReturnStmt
               | IfStmt | ForStmt | WhileStmt | ExprStmt ;

LetStmt        = "let" , [ "mut" ] , Identifier , [ ":" , Type ] , "=" , Expr ;

AssignStmt     = Identifier , "=" , Expr ;

ReturnStmt     = "return" , [ Expr ] ;

IfStmt         = "if" , Expr , Block , [ "else" , ( IfStmt | Block ) ] ;

ForStmt        = "for" , Identifier , "in" , Expr , Block ;

WhileStmt      = "while" , Expr , Block ;

ExprStmt       = Expr ;

(* ---------- Ekspresi ----------
   `if` dan `match` adalah ekspresi; sebagai statement-nya boleh diikuti
   tanpa titik koma karena statement dipisah newline. *)

Expr           = Lambda | OrExpr ;

Lambda         = "fn" , "(" , [ LambdaParams ] , ")" , "=>" , ( Expr | Block ) ;

LambdaParams   = Identifier , { "," , Identifier } ;   (* tipe parameter lambda diinferensi *)

OrExpr         = AndExpr , { "||" , AndExpr } ;

AndExpr        = EqExpr , { "&&" , EqExpr } ;

EqExpr         = RelExpr , [ ( "==" | "!=" ) , RelExpr ] ;

RelExpr        = AddExpr , [ ( "<" | "<=" | ">" | ">=" ) , AddExpr ] ;

AddExpr        = MulExpr , { ( "+" | "-" ) , MulExpr } ;

MulExpr        = UnaryExpr , { ( "*" | "/" | "%" ) , UnaryExpr } ;

UnaryExpr      = [ ( "!" | "-" ) ] , PostfixExpr ;

PostfixExpr    = Primary , { PostfixOp } ;

(* `p.f()` pada nilai ber-tipe struct yang punya fungsi ber-receiver `f`
   di package-nya adalah sugar untuk `f(p)`. Tidak ada dispatch dinamis. *)
PostfixOp      = "." , Identifier
               | "(" , [ ArgList ] , ")"
               | "[" , Expr , "]"          (* lookup parsial: Option<T> *)
               | "?" ;

ArgList        = NamedArg , { "," , NamedArg }
               | Expr , { "," , Expr } ;      (* tidak boleh dicampur *)

NamedArg       = Identifier , ":" , Expr ;    (* hanya sah pada konstruksi struct / JSX *)

Primary        = IntLit | FloatLit | StringLit | BoolLit
               | "None"
               | Identifier , [ Generics ]      (* referensi variabel / tipe *)
               | ListLit
               | DictLit
               | Template
               | TaggedTemplate
               | Jsx
               | IfExpr
               | MatchExpr
               | "(" , Expr , ")" ;

IfExpr         = "if" , Expr , Block , [ "else" , ( IfExpr | Block ) ] ;

MatchExpr      = "match" , Expr , "{" , { MatchArm } , "}" ;

MatchArm       = Pattern , "=>" , ( Expr | Block ) ;

Pattern        = "_"
               | "None"
               | TypePath , [ "(" , [ Pattern , { "," , Pattern } ] , ")" ] ;

ListLit        = "[" , [ Expr , { "," , Expr } ] , "]" ;

(* Dict: key selalu string literal; kosong ditulis "[:]". *)
DictLit        = "[" , ( ":" | StringLit , ":" , Expr , { "," , StringLit , ":" , Expr } ) , "]" ;

(* ---------- Template ---------- *)

Template       = "`" , { TemplatePart } , "`" ;

TemplatePart   = Text , [ "${" , Expr , "}" ] ;

(* Tag adalah path ke fungsi package-level, bukan method. *)
TaggedTemplate = TypePath , Template ;

(* ---------- JSX ---------- *)

(* Nama tag = nama struct yang terlihat di scope. Atribut = nama field.
   Huruf kecil = compile error (nama tipe wajib PascalCase). *)
Jsx            = "<" , TypePath , { JsxAttr } , ( "/>" | ">" , { JsxChild } , "</" , TypePath , ">" ) ;

JsxAttr        = Identifier , "=" , ( StringLit | "{" , Expr , "}" ) ;

JsxChild       = Jsx | JsxText | "{" , Expr , "}" ;

JsxText        = { Character - ( "<" | "{" ) } ;

(* ---------- Leksikal ---------- *)

Identifier     = letter , { letter | digit | "_" } ;

IntLit         = digit , { digit | "_" } ;

FloatLit       = digit , { digit | "_" } , "." , digit , { digit | "_" } ,
                 [ ( "e" | "E" ) , [ "+" | "-" ] , digit , { digit } ] ;

BoolLit        = "true" | "false" ;

StringLit      = '"' , { StringChar } , '"' ;

StringChar     = ordinary_char | Escape ;

Escape         = "\\" , ( "n" | "t" | "r" | "\\" | '"' | "`" | "$" )
               | "\\u{" , hex , { hex } , "}" ;

Comment        = "//" , { any - newline } , newline
               | "/*" , { any - "*/" } , "*/" ;     (* tidak bersarang *)

(* ---------- Kata kunci (dicadangkan) ---------- *)
(* package export struct enum fn test let mut return if else
   for in while match import from as true false None _  *)

(* Kata kunci v1 yang dihapus TETAP dicadangkan agar errornya jelas:
   class pub static self  *)

(* Soft keyword (lihat spec §7). Posisi yang sudah pasti nama menerima kata
   kunci: setelah ".", dan sebelum ":" (field, label, parameter, atribut JSX).
   Nama fungsi/binding/package dan item import hanya menerima from, as, in. *)
NameAfterDot   = Identifier | Keyword ;   (* b.from, b.match *)

SoftName       = Identifier | "from" | "as" | "in" ;

FieldName      = NameAfterDot ;           (* selalu diikuti ":" *)
AttrName       = NameAfterDot ;           (* selalu diikuti "=" *)
