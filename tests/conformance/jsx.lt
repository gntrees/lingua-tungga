package jsx {
  export struct Label {
    value: Str
    children: List<Str>
  }

  export fn make_label(prefix: Str, text: Str) -> Label {
    <Label value="prefix">{prefix}</Label>
  }

  export fn plain() -> Label {
    <Label value="plain"></Label>
  }

  test "expression child" {
    let node = make_label("hi", "ignored")
    expect.eq(node.value, "prefix")
    expect.eq(node.children, ["hi"])
  }

  test "empty children" {
    expect.eq(plain().children.len(), 0)
  }
}
