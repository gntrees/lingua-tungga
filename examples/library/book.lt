pub enum Genre {
  Fiction
  NonFiction
  Reference
}

pub class Book {
  title: Str
  author: Str
  genre: Genre
  year: Int

  pub fn genre_label(self) -> Str {
    match self.genre {
      Genre.Fiction => "fiction"
      Genre.NonFiction => "non-fiction"
      Genre.Reference => "reference"
    }
  }

  pub fn describe(self) -> Str {
    `"${self.title}" by ${self.author} (${self.year}, ${self.genre_label()})`
  }
}
