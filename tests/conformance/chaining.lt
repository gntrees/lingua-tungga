package chaining {
  export struct ChainUser {
    name: Str
  }

  export fn greet(u: ChainUser) -> Str {
    `hi ${u.name}`
  }

  export fn anonymous() -> ChainUser {
    ChainUser(name: "  ada  ")
  }

  export fn words(xs: List<Str>) -> Str {
    xs.filter(fn(x) => x.len() > 0).map(fn(x) => x.trim().upper()).join(",")
  }

  export fn total(xs: List<Str>) -> Int {
    xs.map(fn(x) => x.len()).fold(0, fn(acc, n) => acc + n)
  }

  export fn number(text: Str) -> Int {
    text.trim().parse_int().unwrap_or(0)
  }

  export fn greeting() -> Str {
    anonymous().greet_trimmed()
  }

  export fn greet_trimmed(u: ChainUser) -> Str {
    greet(u).trim()
  }

  export fn doubled(xs: List<Int>) -> Int {
    xs.filter(fn(x) => x > 0).map(fn(x) => x * 2).len()
  }

  test "chains list methods" {
    expect.eq(words(["a", "  b ", ""]), "A,B")
    expect.eq(total(["ab", "c"]), 3)
  }

  test "chains option after result" {
    expect.eq(number(" 42 "), 42)
    expect.eq(number("nope"), 0)
  }

  test "chains receiver then method" {
    expect.eq(greeting(), "hi   ada")
  }

  test "chains across lines" {
    expect.eq(doubled([-1, 1, 2]), 2)
  }
}
