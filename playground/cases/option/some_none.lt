package some_none {
  export fn one() -> Option<Int> {
    Some(1)
  }

  export fn nothing() -> Option<Int> {
    None
  }

  test "some equals some" {
    expect.eq(one(), Some(1))
  }

  test "none equals none" {
    expect.eq(nothing(), None)
  }

  test "is some" {
    expect.true(one().is_some())
  }

  test "is none" {
    expect.true(nothing().is_none())
  }
}
