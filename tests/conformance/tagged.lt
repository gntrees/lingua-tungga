package tagged {
  export enum SqlArg {
    I(Int)
    S(Str)
  }

  export struct Query {
    text: Str
  }

  export fn compose(parts: List<Str>, values: List<SqlArg>) -> Query {
    let rendered = values.map(
      fn(value) => (match value {
        SqlArg.I(n) => `i${n}`
        SqlArg.S(s) => `s${s}`
      }),
    )
    Query(text: `${parts.join("|")}::${rendered.join("|")}`)
  }

  test "keeps parts and typed values apart" {
    let id = 7
    let name = "bo"
    let query = compose`SELECT * FROM t WHERE id = ${SqlArg.I(id)} AND name = ${SqlArg.S(name)}`
    expect.eq(query.text, "SELECT * FROM t WHERE id = | AND name = |::i7|sbo")
  }

  test "handles empty tail" {
    let query = compose`x ${SqlArg.I(1)}`
    expect.eq(query.text, "x |::i1")
  }

  test "to_string is available for migration" {
    let id = 7
    expect.eq(id.to_string(), "7")
  }

  test "to_string works on nominal values" {
    expect.eq(SqlArg.I(7).to_string(), "SqlArg.I(7)")
  }
}
