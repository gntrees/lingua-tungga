package generic {
  export enum MaybeBox<T> {
    Empty
    Value(T)
  }

  export fn label(value: MaybeBox<Int>) -> Str {
    match value {
      MaybeBox.Empty => "empty"
      MaybeBox.Value(n) => `value:${n}`
    }
  }

  test "generic enum keeps type arguments" {
    let empty: MaybeBox<Int> = MaybeBox.Empty
    expect.eq(label(empty), "empty")
    expect.eq(label(MaybeBox.Value(7)), "value:7")
  }
}
