import book { Book } from "./book.lt"

package catalog {
  export struct Catalog {
    books: List<Book>
  }

  export fn empty() -> Catalog {
    Catalog(books: [])
  }

  export fn add(c: Catalog, book: Book) -> Catalog {
    Catalog(books: c.books.push(book))
  }

  export fn size(c: Catalog) -> Int {
    c.books.len()
  }

  export fn find_by_author(c: Catalog, author: Str) -> List<Book> {
    c.books.filter(fn(book) => book.author == author)
  }

  export fn newest(c: Catalog) -> Option<Book> {
    let mut best: Option<Book> = None
    for book in c.books {
      best = match best {
        None => Some(book)
        Some(current) => if book.year > current.year {
          Some(book)
        } else {
          best
        }
      }
    }
    best
  }
}
