package book {
  export enum Genre {
    Fiction
    NonFiction
    Reference
  }

  export struct Book {
    title: Str
    author: Str
    genre: Genre
    year: Int
  }

  export fn genre_label(b: Book) -> Str {
    match b.genre {
      Genre.Fiction => "fiction"
      Genre.NonFiction => "non-fiction"
      Genre.Reference => "reference"
    }
  }

  export fn describe(b: Book) -> Str {
    `"${b.title}" by ${b.author} (${b.year}, ${b.genre_label()})`
  }
}
