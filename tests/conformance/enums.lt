package enums {
  export enum Shape {
    Circle(Float)
    Rect(Float, Float)
    Point
  }

  export fn area(shape: Shape) -> Float {
    match shape {
      Shape.Circle(radius) => math.pi() * radius * radius
      Shape.Rect(width, height) => width * height
      Shape.Point => 0.0
    }
  }

  export struct Box<T> {
    value: T
  }

  export fn get<T>(b: Box<T>) -> T {
    b.value
  }

  test "payloads are bound" {
    expect.true(area(Shape.Rect(2.0, 3.0)) > 5.9)
    expect.eq(area(Shape.Point), 0.0)
  }

  test "generic struct infers" {
    let box = Box(value: 7)
    expect.eq(box.get(), 7)
  }
}
