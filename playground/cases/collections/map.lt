package map_case {
  export struct Point {
    x: Int
    y: Int
  }

  test "inserts and reads" {
    let empty: Map<Str, Int> = map.empty()
    let filled = empty.insert("b", 2).insert("a", 1)
    expect.eq(filled.get("a"), Some(1))
    expect.eq(filled.len(), 2)
    expect.eq(filled.keys(), ["a", "b"])
    expect.eq(empty.len(), 0)
  }

  test "struct keys follow ord" {
    let empty: Map<Point, Str> = map.empty()
    let filled = empty.insert(Point(x: 10, y: 0), "ten").insert(Point(x: 2, y: 0), "two")
    expect.eq(filled.keys(), [Point(x: 2, y: 0), Point(x: 10, y: 0)])
  }

  test "removes" {
    let empty: Map<Str, Int> = map.empty()
    expect.eq(empty.insert("a", 1).remove("a").len(), 0)
  }
}
