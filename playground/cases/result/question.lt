package question {
  export fn number(text: Str) -> Result<Int, Str> {
    match text.parse_int() {
      Some(value) => Ok(value)
      None => Err("not a number")
    }
  }

  export fn double(text: Str) -> Result<Int, Str> {
    let value = number(text)?
    Ok(value * 2)
  }

  test "success" {
    expect.eq(double("21"), Ok(42))
  }

  test "propagates error" {
    expect.eq(double("x"), Err("not a number"))
  }
}
