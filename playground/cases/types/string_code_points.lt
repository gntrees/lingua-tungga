package string_code_points {
  export fn length(text: Str) -> Int {
    text.len()
  }

  export fn middle(text: Str) -> Str {
    text.slice(1, 3)
  }

  test "counts code points" {
    expect.eq(length("héllo"), 5)
    expect.eq(length("👍"), 1)
  }

  test "slices code points" {
    expect.eq(middle("héllo"), "él")
  }
}
