package options {
  export fn find(xs: List<Int>, target: Int) -> Option<Int> {
    xs.index_of(target)
  }

  export fn parse(text: Str) -> Result<Int, Str> {
    match text.parse_int() {
      Some(value) => Ok(value)
      None => Err("not a number")
    }
  }

  export fn double(text: Str) -> Result<Int, Str> {
    let value = parse(text)?
    Ok(value * 2)
  }

  test "option helpers" {
    expect.eq(find([1, 2], 2), Some(1))
    expect.eq(find([1, 2], 9), None)
    expect.eq(find([1, 2], 9).unwrap_or(-1), -1)
    expect.eq(find([1, 2], 2).map(fn(x) => x + 10), Some(11))
    expect.true(find([1, 2], 2).is_some())
    expect.true(find([1, 2], 9).is_none())
  }

  test "result propagation" {
    expect.eq(double("21"), Ok(42))
    expect.eq(double("x"), Err("not a number"))
  }

  test "result helpers" {
    expect.eq(parse("7").map(fn(x) => x + 1), Ok(8))
    expect.eq(parse("x").map_err(fn(e) => `bad: ${e}`), Err("bad: not a number"))
    expect.eq(parse("x").unwrap_or(0), 0)
  }
}
