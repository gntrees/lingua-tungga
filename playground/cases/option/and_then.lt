pub class Maybe {
  static fn positive(x: Int) -> Option<Int> {
    if x > 0 {
      Some(x)
    } else {
      None
    }
  }
}

test class AndThenTest {
  test fn chains_some() {
    Expect.equal(Maybe.positive(4).and_then(fn(x) => Maybe.positive(x + 1)), Some(5))
  }

  test fn short_circuits() {
    Expect.equal(Maybe.positive(0).and_then(fn(x) => Maybe.positive(x + 1)), None)
  }
}
