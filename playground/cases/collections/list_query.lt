package list_query {
  test "contains and index" {
    expect.true([1, 2, 3].contains(2))
    expect.eq([1, 2, 3].index_of(3), Some(2))
  }

  test "safe get" {
    expect.eq([1, 2].get(1), Some(2))
    expect.eq([1, 2].get(9), None)
  }

  test "any and all" {
    expect.true([1, 2].any(fn(x) => x > 1))
    expect.false([1, 2].all(fn(x) => x > 1))
  }
}
