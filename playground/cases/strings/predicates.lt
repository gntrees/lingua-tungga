package predicates {
  export fn mentions(text: Str, part: Str) -> Bool {
    text.contains(part)
  }

  export fn starts(text: Str, prefix: Str) -> Bool {
    text.starts_with(prefix)
  }

  export fn chars(text: Str) -> List<Str> {
    text.chars()
  }

  test "predicates" {
    expect.true(mentions("hello", "ell"))
    expect.true(starts("hello", "he"))
    expect.false("hello".ends_with("lo!"))
  }

  test "chars" {
    expect.eq(chars("ab"), ["a", "b"])
    expect.eq(chars("👍").len(), 1)
  }
}
