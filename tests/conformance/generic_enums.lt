package generic_enums {
  export enum MaybeBox<T> {
    Empty
    Value(T)
  }

  fn describe_int(value: MaybeBox<Int>) -> Str {
    match value {
      MaybeBox.Empty => "empty"
      MaybeBox.Value(n) => `value:${n}`
    }
  }

  fn describe_str(value: MaybeBox<Str>) -> Str {
    match value {
      MaybeBox.Empty => "empty"
      MaybeBox.Value(text) => `value:${text}`
    }
  }

  test "nullary variant works for any type argument" {
    let empty_int: MaybeBox<Int> = MaybeBox.Empty
    let empty_str: MaybeBox<Str> = MaybeBox.Empty
    expect.eq(describe_int(empty_int), "empty")
    expect.eq(describe_str(empty_str), "empty")
  }

  test "payload variant infers the type argument" {
    expect.eq(describe_int(MaybeBox.Value(7)), "value:7")
    expect.eq(describe_str(MaybeBox.Value("bo")), "value:bo")
  }
}
