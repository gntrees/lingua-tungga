package payload {
  export enum Shape {
    Circle(Float)
    Rect(Float, Float)
  }

  export fn area(shape: Shape) -> Float {
    match shape {
      Shape.Circle(radius) => math.pi() * radius * radius
      Shape.Rect(width, height) => width * height
    }
  }

  test "area of rect" {
    expect.eq(area(Shape.Rect(2.0, 3.0)), 6.0)
  }
}
