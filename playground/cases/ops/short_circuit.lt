package short_circuit {
  export fn and_skips() -> Bool {
    let zero = 0
    false && 1 / zero == 0
  }

  export fn or_skips() -> Bool {
    let zero = 0
    true || 1 / zero == 0
  }

  test "and skips right" {
    expect.false(and_skips())
  }

  test "or skips right" {
    expect.true(or_skips())
  }
}
