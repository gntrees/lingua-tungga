import book { Book, Genre, describe } "./book.lt"
import catalog { Catalog, add, empty, find_by_author, newest, size } "./catalog.lt"

package catalog_test {
  fn sample() -> Catalog {
    let first = Book(title: "Dune", author: "Frank", genre: Genre.Fiction, year: 1965)
    let second = Book(title: "Code", author: "Ada", genre: Genre.Reference, year: 2020)
    add(add(empty(), first), second)
  }

  test "describes a book" {
    let book = Book(title: "Dune", author: "Frank", genre: Genre.Fiction, year: 1965)
    expect.eq(describe(book), "\"Dune\" by Frank (1965, fiction)")
  }

  test "adds books" {
    expect.eq(size(sample()), 2)
  }

  test "filters by author" {
    expect.eq(find_by_author(sample(), "Ada").len(), 1)
    expect.eq(find_by_author(sample(), "Nobody").len(), 0)
  }

  test "newest uses year" {
    expect.eq(newest(sample()).map(fn(book) => book.title), Some("Code"))
  }

  test "empty catalog has no newest" {
    expect.eq(newest(empty()), None)
  }
}
