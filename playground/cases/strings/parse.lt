package parse {
  export fn to_int(text: Str) -> Option<Int> {
    text.parse_int()
  }

  export fn to_float(text: Str) -> Option<Float> {
    text.parse_float()
  }

  test "parses int" {
    expect.eq(to_int(" 42 "), Some(42))
    expect.eq(to_int("nope"), None)
  }

  test "parses float" {
    expect.eq(to_float("1.5"), Some(1.5))
    expect.eq(to_float(""), None)
  }
}
