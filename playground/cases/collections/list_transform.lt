package list_transform {
  test "maps" {
    expect.eq([1, 2, 3].map(fn(x) => x * 2), [2, 4, 6])
  }

  test "filters" {
    expect.eq([1, 2, 3, 4].filter(fn(x) => x % 2 == 0), [2, 4])
  }

  test "original unchanged" {
    let xs = [1, 2]
    let ys = xs.push(3)
    expect.eq(xs, [1, 2])
    expect.eq(ys, [1, 2, 3])
  }
}
