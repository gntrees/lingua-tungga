package guards_case {
  export enum E {
    A(Int)
    B(Int)
    C
  }

  export fn pick(e: E) -> Int {
    match e {
      E.A(n) | E.B(n) => n
      E.C => 0
    }
  }

  export fn positive(o: Option<Int>) -> Int {
    match o {
      Some(n) if n > 0 => n
      Some(n) => 0 - n
      None => 0
    }
  }

  test "or patterns share bindings" {
    expect.eq(pick(E.A(2)), 2)
    expect.eq(pick(E.B(3)), 3)
    expect.eq(pick(E.C), 0)
  }

  test "guards fall through" {
    expect.eq(positive(Some(4)), 4)
    expect.eq(positive(Some(-4)), 4)
    expect.eq(positive(None), 0)
  }
}
