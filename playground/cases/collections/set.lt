package set {
  export fn dedupe(xs: List<Int>) -> Set<Int> {
    let empty: Set<Int> = set.empty()
    xs.fold(empty, fn(acc, x) => acc.insert(x))
  }

  test "deduplicates" {
    expect.eq(dedupe([1, 1]).len(), 1)
  }

  test "combines" {
    let empty: Set<Int> = set.empty()
    let left = empty.insert(1).insert(2)
    let right = empty.insert(2).insert(3)
    expect.eq(left.union(right).len(), 3)
    expect.eq(left.intersect(right).len(), 1)
    expect.true(left.difference(right).contains(1))
  }
}
