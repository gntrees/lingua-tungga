package map_err {
  export fn bumped(value: Result<Int, Str>) -> Result<Int, Str> {
    value.map(fn(x) => x + 1)
  }

  export fn annotated(value: Result<Int, Str>) -> Result<Int, Str> {
    value.map_err(fn(message) => `oops: ${message}`)
  }

  test "maps ok" {
    expect.eq(bumped(Ok(2)), Ok(3))
  }

  test "maps err" {
    expect.eq(annotated(Err("bad")), Err("oops: bad"))
  }
}
