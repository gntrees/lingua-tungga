package loops {
  export fn sum(xs: List<Int>) -> Int {
    let mut total = 0
    for x in xs {
      total = total + x
    }
    total
  }

  export fn count_down(start: Int) -> Int {
    let mut left = start
    let mut steps = 0
    while left > 0 {
      left = left - 1
      steps = steps + 1
    }
    steps
  }

  export fn first_negative(xs: List<Int>) -> Int {
    for x in xs {
      if x < 0 {
        return x
      }
    }
    0
  }

  test "for loop accumulates" {
    expect.eq(sum([1, 2, 3]), 6)
    expect.eq(sum([]), 0)
  }

  test "while loop counts" {
    expect.eq(count_down(3), 3)
    expect.eq(count_down(0), 0)
  }

  test "early return inside loop" {
    expect.eq(first_negative([1, -2, 3]), -2)
    expect.eq(first_negative([1, 2]), 0)
  }
}
