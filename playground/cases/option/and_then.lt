package and_then {
  export fn positive(x: Int) -> Option<Int> {
    if x > 0 {
      Some(x)
    } else {
      None
    }
  }

  test "chains some" {
    expect.eq(positive(4).and_then(fn(x) => positive(x + 1)), Some(5))
  }

  test "short circuits" {
    expect.eq(positive(0).and_then(fn(x) => positive(x + 1)), None)
  }
}
