package exhaustive {
  export enum Color {
    Red
    Green
    Blue
  }

  export fn label(color: Color) -> Str {
    match color {
      Color.Red => "red"
      Color.Green => "green"
      Color.Blue => "blue"
    }
  }

  test "labels every variant" {
    expect.eq(label(Color.Green), "green")
  }
}
