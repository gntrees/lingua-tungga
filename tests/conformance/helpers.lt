package helpers {
  export fn double(x: Int) -> Int {
    x * 2
  }

  fn double_twice(x: Int) -> Int {
    double(double(x))
  }

  fn quadruple(x: Int) -> Int {
    double_twice(x)
  }

  test "calls a helper" {
    expect.eq(double_twice(3), 12)
  }

  test "helper calls helper" {
    expect.eq(quadruple(2), 8)
  }
}
