package user {
  export enum Role {
    Admin
    Member(Int)
    Guest
  }

  export struct User {
    name: Str
    age: Int
    role: Role
  }

  export fn greet(u: User) -> Str {
    `Hi ${u.name}, you are ${u.age}`
  }

  export fn label(u: User) -> Str {
    match u.role {
      Role.Admin => "admin"
      Role.Member(n) => `member-${n}`
      Role.Guest => "guest"
    }
  }

  export fn anonymous() -> User {
    User(name: "?", age: 0, role: Role.Guest)
  }
}
